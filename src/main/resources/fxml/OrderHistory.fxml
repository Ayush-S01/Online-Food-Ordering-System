<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodordering.controller.OrderHistoryController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Label text="📋 My Orders" styleClass="nav-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="menuButton" text="Browse Menu" onAction="#handleMenu" styleClass="nav-btn"/>
            <Button fx:id="homeButton" text="🏠 Home"     onAction="#handleHome" styleClass="nav-btn"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding><Insets top="24" right="40" bottom="24" left="40"/></padding>
            <Label text="Your Order History" styleClass="page-title"/>

            <Label fx:id="emptyLabel"
                   text="📭 You haven't placed any orders yet. Start ordering now!"
                   styleClass="empty-state-label" visible="false"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox fx:id="ordersContainer" spacing="14"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
