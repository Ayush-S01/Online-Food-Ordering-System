<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.foodordering.controller.RegisterController"
           styleClass="root-pane"
           style="-fx-background-color: linear-gradient(to bottom right, #FFF3ED, #FFE4D6, #F8F9FA);">

    <!-- Centered Modern Split Auth Card for Registration -->
    <HBox alignment="CENTER" maxWidth="880" maxHeight="590" styleClass="auth-split-card">

        <!-- Left Brand & Benefits Showcase Panel -->
        <VBox alignment="CENTER_LEFT" spacing="20" prefWidth="390" minWidth="370" styleClass="auth-brand-panel">
            <padding><Insets top="40" right="36" bottom="40" left="40"/></padding>

            <!-- Brand Header -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🍽️" style="-fx-font-size: 32px;"/>
                    <Label text="FoodHub" styleClass="auth-brand-title"/>
                </HBox>
                <Label text="Join FoodHub &amp; Taste the Best" styleClass="auth-brand-tagline"/>
            </VBox>

            <Separator style="-fx-opacity: 0.35;"/>

            <!-- Value Props List -->
            <VBox spacing="14">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="feature-icon-box">
                        <Label text="🎁" style="-fx-font-size: 16px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Flat 10% Off On Your First Order" styleClass="feature-title"/>
                        <Label text="Use promo code WELCOME10 at checkout" styleClass="feature-desc"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="feature-icon-box">
                        <Label text="🚀" style="-fx-font-size: 16px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Lightning Fast 1-Click Ordering" styleClass="feature-title"/>
                        <Label text="Saved cart, recommendations &amp; real-time tracking" styleClass="feature-desc"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="feature-icon-box">
                        <Label text="🔒" style="-fx-font-size: 16px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Safe &amp; Secure Checkout" styleClass="feature-title"/>
                        <Label text="Simulated Instant UPI, Cards, Net Banking &amp; COD" styleClass="feature-desc"/>
                    </VBox>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Cuisine Emoji Ribbon -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🍕" style="-fx-font-size: 22px;"/>
                <Label text="🍛" style="-fx-font-size: 22px;"/>
                <Label text="🥞" style="-fx-font-size: 22px;"/>
                <Label text="🥢" style="-fx-font-size: 22px;"/>
                <Label text="🌮" style="-fx-font-size: 22px;"/>
                <Label text="🍔" style="-fx-font-size: 22px;"/>
                <Label text="🍚" style="-fx-font-size: 22px;"/>
            </HBox>
        </VBox>

        <!-- Right Register Form Panel -->
        <VBox alignment="CENTER_LEFT" spacing="11" prefWidth="490" styleClass="auth-form-panel">
            <padding><Insets top="30" right="44" bottom="30" left="44"/></padding>

            <VBox spacing="3">
                <Label text="Create Account ✨" styleClass="auth-form-title"/>
                <Label text="Sign up with Google or create an account with email" styleClass="auth-form-subtitle"/>
            </VBox>

            <!-- Google Sign-Up Button -->
            <Button fx:id="googleSignupButton" text="  Sign up with Google"
                    styleClass="auth-google-btn" maxWidth="Infinity" onAction="#handleGoogleSignup">
                <graphic>
                    <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                        <image>
                            <Image url="@../images/google_logo.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS" style="-fx-opacity: 0.45;"/>
                <Label text="or register with email" styleClass="auth-divider-text"/>
                <Separator HBox.hgrow="ALWAYS" style="-fx-opacity: 0.45;"/>
            </HBox>

            <!-- Name Field -->
            <VBox spacing="3" maxWidth="Infinity">
                <Label text="Full Name *" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="e.g. Ayush Satyam" styleClass="input-field-modern"/>
            </VBox>

            <!-- Email Field -->
            <VBox spacing="3" maxWidth="Infinity">
                <Label text="Email Address *" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="e.g. ayush@example.com" styleClass="input-field-modern"/>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="3" maxWidth="Infinity">
                <Label text="Password (min 6 characters) *" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Create a secure password" styleClass="input-field-modern"/>
            </VBox>

            <!-- Confirm Password Field -->
            <VBox spacing="3" maxWidth="Infinity">
                <Label text="Confirm Password *" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" styleClass="input-field-modern"/>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true" visible="false"/>

            <!-- Create Account Submit Button -->
            <Button fx:id="registerButton" text="Create Account &amp; Start Ordering →"
                    styleClass="auth-primary-btn" maxWidth="Infinity" onAction="#handleRegister"/>

            <!-- Login Link -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Already have an account?" styleClass="auth-hint"/>
                <Hyperlink fx:id="loginLink" text="Sign In"
                           onAction="#handleLoginLink" styleClass="auth-link"/>
            </HBox>
        </VBox>

    </HBox>
</StackPane>
