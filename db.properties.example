# db.properties.example
# Copy this file to db.properties (in the same directory or on the classpath root)
# and fill in your MySQL credentials.
# db.properties is listed in .gitignore — NEVER commit real credentials.

db.url=jdbc:mysql://localhost:3306/food_ordering_system?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
db.username=root
db.password=YOUR_MYSQL_PASSWORD_HERE
